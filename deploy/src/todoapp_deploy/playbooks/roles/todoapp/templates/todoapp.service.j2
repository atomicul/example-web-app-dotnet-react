[Unit]
Description=Todo app
Wants=network-online.target todoapp-dapr.service
After=network-online.target mssql-server.service todoapp-dapr.service

[Service]
Type=exec
User=todoapp
Group=todoapp
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory={{ todoapp_install_dir }}/current
ExecStart={{ dotnet_root }}/dotnet {{ todoapp_install_dir }}/current/TodoApi.dll
EnvironmentFile={{ todoapp_config_dir }}/database.env
EnvironmentFile={{ todoapp_config_dir }}/certificate.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ROOT={{ dotnet_root }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
