{% set password = todoapp_database_password.user_input | replace("'", "''") %}
{% set connection_string = "Server=127.0.0.1," ~ mssql_port ~ ";Database=" ~ todoapp_database ~ ";User ID=" ~ todoapp_database_login ~ ";Password='" ~ password ~ "';TrustServerCertificate=True" %}
ConnectionStrings__Default="{{ connection_string | replace('\\', '\\\\') | replace('"', '\\"') }}"
